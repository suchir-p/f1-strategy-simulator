# Copy to .env (never commit .env). Values here are read by docker compose.

# development: local defaults allowed. production: refuses default database
# credentials, hides the job list, rate-limits submissions (docs/deployment.md).
F1SIM_ENV=production

POSTGRES_USER=f1sim
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=f1sim

# Simulation submissions per client per minute (production default: 20).
F1SIM_RATE_LIMIT_PER_MINUTE=20
# Worker processes x OpenMP threads should not exceed the machine's cores.
F1SIM_MAX_WORKERS=1
F1SIM_OMP_THREADS_PER_WORKER=2
F1SIM_WEB_PORT=3000
# Only if a platform load balancer sits in front of the stack: its address
# range, so the visitor's address is taken from its X-Forwarded-For.
# F1SIM_TRUSTED_PROXY_CIDR=10.0.0.0/8
