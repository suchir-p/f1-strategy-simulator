# Public entry point of the docker compose stack (docs/deployment.md).
#
# The API rate-limits per client using the first X-Forwarded-For address, and
# the dashboard (Next.js) passes along whatever X-Forwarded-For it receives.
# So this proxy must be the one place that decides the client address: it
# overwrites the header with the address that actually connected, and anything
# a client sends in that header is discarded.
#
# Behind a platform load balancer, every connection comes from the balancer.
# Set F1SIM_TRUSTED_PROXY_CIDR to the balancer's address range: nginx then
# takes the visitor's address from the balancer's X-Forwarded-For (realip
# module), and still forwards only that one address. The default trusts no one.

limit_req_zone $binary_remote_addr zone=perclient:10m rate=20r/s;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 64k;

    set_real_ip_from ${F1SIM_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        # Coarse flood protection for every request; the API's per-client
        # limits on simulations are the fine-grained ones.
        limit_req zone=perclient burst=60 nodelay;
        limit_req_status 429;

        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
